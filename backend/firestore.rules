rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // Public profiles and every index are written only by Cloud Functions (Admin SDK). Profiles can
    // be read one at a time by uid, never listed, so the whole player base can't be downloaded.
    match /profiles/{uid}            { allow get: if signedIn(); allow list, write: if false; }
    match /usernames/{name}          { allow read, write: if false; }
    match /friendCodes/{code}        { allow read, write: if false; }
    match /private/{uid}             { allow read, write: if false; }

    // Private cloud save. Gems here can be edited by a determined player; they only buy cosmetics.
    // The app merges before every write, so each write carries a higher rev than the stored copy.
    function validSave(d) {
      return d.keys().hasOnly(['rev','gems','ledger','unlockedThemes','selectedTheme','bests','streak',
          'lastDaily','gamesPlayed','settings','updatedAt'])
        && d.rev is int && d.gems is int && d.gems >= 0 && d.gems <= 1000000
        && (!('ledger' in d) || (d.ledger is map && d.ledger.size() <= 50));
    }
    // Set by account deletion; an ID token issued before it stays valid for up to an hour.
    function beingDeleted(uid) { return exists(/databases/$(db)/documents/deleted/$(uid)); }

    match /deleted/{uid}             { allow read, write: if false; }

    match /users/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid) && validSave(request.resource.data) && !beingDeleted(uid);
      allow update: if isMe(uid) && validSave(request.resource.data) && !beingDeleted(uid)
        && request.resource.data.rev > resource.data.rev;
      match /friends/{friendUid}     { allow read: if isMe(uid); allow write: if false; }
    }

    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow write: if false;
    }

    match /leaderboards/{board}/entries/{uid} { allow read: if signedIn(); allow write: if false; }
  }
}
