<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Nothing goes to Google's cloud backup: the save holds gems and unlocks, and a
     restored or edited copy would merge into the cloud save. Signed-in players restore through the
     cloud save instead. Phone-to-phone transfer keeps everything, so guests don't lose progress. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
